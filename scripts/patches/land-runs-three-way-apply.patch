     if r.returncode != 0:
         # Against a fresh origin/main this is a real "the file moved on", not a dirty-tree refusal.
         print("land_runs: the patch does not apply to today's origin/main: %s"
@@ -879,7 +912,7 @@ def _land_locked_shared_tree(run_dir: Path, a: dict):
     # `git apply` is atomic: a failed apply changes nothing, so there is nothing to undo — which
     # is what makes it safe to stop calling _undo on that path at all.
     pre = _snapshot(touched | set(created))
-    if git("apply", str(patch)).returncode != 0:
