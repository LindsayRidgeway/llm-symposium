diff --git a/tests/test_mail_identity_credentials.py b/tests/test_mail_identity_credentials.py
new file mode 100644
--- /dev/null
+++ b/tests/test_mail_identity_credentials.py
@@ -0,0 +1,68 @@
+#!/usr/bin/env python3
+"""Offline regression tests for mail identity credential isolation."""
+
+from __future__ import annotations
+
+import os
+import unittest
+from unittest.mock import patch
+
+from channels.mail import credentials_for
+
+
+GENERIC = {
+    "SYMPOSIUM_MAIL_USER": "desi-legacy@example.test",
+    "SYMPOSIUM_MAIL_APP_PASSWORD": "generic-secret",
+}
+
+IDENTITY_KEYS = {
+    "SYMPOSIUM_MAIL_USER_DESI",
+    "SYMPOSIUM_MAIL_APP_PASSWORD_DESI",
+    "SYMPOSIUM_MAIL_USER_CLAUDE",
+    "SYMPOSIUM_MAIL_APP_PASSWORD_CLAUDE",
+    "SYMPOSIUM_MAIL_USER_GEMINI",
+    "SYMPOSIUM_MAIL_APP_PASSWORD_GEMINI",
+    "SYMPOSIUM_MAIL_USER_TARIK",
+    "SYMPOSIUM_MAIL_APP_PASSWORD_TARIK",
+}
+
+
+class MailIdentityCredentialTests(unittest.TestCase):
+    def clean_env(self, **values: str):
+        env = {
+            key: value
+            for key, value in os.environ.items()
+            if key not in IDENTITY_KEYS
+            and key not in {
+                "SYMPOSIUM_MAIL_USER",
+                "SYMPOSIUM_MAIL_APP_PASSWORD",
+            }
+        }
+        env.update(values)
+        return patch.dict(os.environ, env, clear=True)
+
+    def test_generic_credentials_are_available_without_explicit_identity(self):
+        with self.clean_env(**GENERIC):
+            self.assertEqual(
+                credentials_for(None),
+                ("desi-legacy@example.test", "generic-secret"),
+            )
+
+    def test_legacy_generic_credentials_may_send_as_desi(self):
+        with self.clean_env(**GENERIC):
+            self.assertEqual(
+                credentials_for("desi"),
+                ("desi-legacy@example.test", "generic-secret"),
+            )
+
+    def test_generic_credentials_cannot_impersonate_other_amigo(self):
+        with self.clean_env(**GENERIC):
+            for identity in ("claude", "gemini", "tarik"):
+                with self.subTest(identity=identity):
+                    self.assertIsNone(credentials_for(identity))
+
+    def test_explicit_identity_credentials_take_precedence(self):
+        values = dict(GENERIC)
+        values.update(
+            SYMPOSIUM_MAIL_USER_CLAUDE="claude@example.test",
+            SYMPOSIUM_MAIL_APP_PASSWORD_CLAUDE="claude-secret",
+        )
+        with self.clean_env(**values):
+            self.assertEqual(
+                credentials_for("claude"),
+                ("claude@example.test", "claude-secret"),
+            )
+
+    def test_partial_explicit_configuration_does_not_fall_back(self):
+        values = dict(GENERIC)
+        values["SYMPOSIUM_MAIL_USER_GEMINI"] = "gemini@example.test"
+        with self.clean_env(**values):
+            self.assertIsNone(credentials_for("gemini"))
+
+
+if __name__ == "__main__":
+    unittest.main()
