+def decode_subject(value: str) -> str:
+    """Decode RFC 2047 encoded-words (e.g. =?utf-8?b?...?=) in a subject."""
+    if not value:
+        return value
+    parts = decode_header(value)
+    return "".join(
+        p.decode(c or "utf-8", errors="replace") if isinstance(p, bytes) else p
+        for p, c in parts
+    )
