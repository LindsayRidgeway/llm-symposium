@@ -314,6 +314,60 @@ def run_mail_channel() -> None:
     sent = drain_outbox()
     fetched = fetch_inbox()
     print(f"Mail channel: sent {sent} draft(s), fetched {fetched} message(s)")
+    _report_sent_folder()
