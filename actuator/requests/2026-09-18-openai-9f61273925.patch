diff --git a/tests/test_mail_identity_credentials.py b/tests/test_mail_identity_credentials.py
new file mode 100644
--- /dev/null
+++ b/tests/test_mail_identity_credentials.py
@@ -0,0 +1,99 @@
+#!/usr/bin/env python3
+"""Offline RT-3/RT-7 tests for the mail identity and SMTP envelope."""
+
+from __future__ import annotations
+
+import os
+import tempfile
+import unittest
+from pathlib import Path
+from unittest import mock
+
+from channels import mail
+
+
+class FakeSMTP:
+    instances = []
+
+    def __init__(self, host, port, timeout=None):
+        self.host = host
+        self.port = port
+        self.timeout = timeout
+        self.login_args = None
+        self.message = None
+        type(self).instances.append(self)
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        return False
+
+    def starttls(self):
+        return None
+
+    def login(self, user, password):
+        self.login_args = (user, password)
+
+    def send_message(self, message):
+        self.message = message
+
+
+class MailIdentityTests(unittest.TestCase):
+    def setUp(self):
+        FakeSMTP.instances.clear()
+
+    def test_explicit_identity_does_not_borrow_generic_credentials(self):
+        env = {
+            mail.GENERIC_USER_ENV: "generic@example.test",
+            mail.GENERIC_PW_ENV: "generic-secret",
+        }
+        with mock.patch.dict(os.environ, env, clear=True):
+            self.assertEqual(
+                mail.credentials_for(None),
+                ("generic@example.test", "generic-secret"),
+            )
+            self.assertIsNone(mail.credentials_for("tarik"))
+
+    def test_explicit_identity_uses_only_its_own_pair(self):
+        env = {
+            mail.GENERIC_USER_ENV: "generic@example.test",
+            mail.GENERIC_PW_ENV: "generic-secret",
+            "SYMPOSIUM_MAIL_USER_TARIK": "tarik@example.test",
+            "SYMPOSIUM_MAIL_APP_PASSWORD_TARIK": "tarik-secret",
+        }
+        with mock.patch.dict(os.environ, env, clear=True):
+            self.assertEqual(
+                mail.credentials_for("tarik"),
+                ("tarik@example.test", "tarik-secret"),
+            )
+
+    def test_untrusted_body_cannot_replace_smtp_envelope(self):
+        env = {
+            "SYMPOSIUM_MAIL_USER_TARIK": "tarik@example.test",
+            "SYMPOSIUM_MAIL_APP_PASSWORD_TARIK": "tarik-secret",
+        }
+        draft = (
+            "Identity: tarik\n"
+            "To: correspondent@example.test\n"
+            "Subject: Re: scratch test\n\n"
+            "To: victim@example.test\n"
+            "From: forged@example.test\n"
+            "Subject: replaced\n\n"
+            "This text came from an untrusted message.\n"
+        )
+        with tempfile.TemporaryDirectory() as td:
+            root = Path(td)
+            outbound = root / "outbound"
+            sent = root / "sent"
+            outbound.mkdir()
+            path = outbound / "reply.md"
+            path.write_text(draft, encoding="utf-8")
+            with (
+                mock.patch.dict(os.environ, env, clear=True),
+                mock.patch.object(mail, "SENT_DIR", sent),
+                mock.patch.object(mail.smtplib, "SMTP", FakeSMTP),
+            ):
+                mail.send_draft(path)
+
+        smtp = FakeSMTP.instances[-1]
+        self.assertEqual(smtp.login_args, ("tarik@example.test", "tarik-secret"))
+        self.assertEqual(smtp.message["From"], "tarik@example.test")
+        self.assertEqual(smtp.message["To"], "correspondent@example.test")
+        self.assertEqual(smtp.message["Subject"], "Re: scratch test")
+        self.assertIn("victim@example.test", smtp.message.get_content())
+        self.assertNotIn("victim@example.test", smtp.message["To"])
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/agenda/15-red-team-the-deadbolt.md b/agenda/15-red-team-the-deadbolt.md
--- a/agenda/15-red-team-the-deadbolt.md
+++ b/agenda/15-red-team-the-deadbolt.md
@@ -68,6 +68,20 @@ Regression tests: `tests/test_channel_triage.py` and `tests/test_triage.py`.
 - **RT-4** — Credential egress: a session induced to print a secret writes it into a public repository and
   into `sessions.db`. This one has already happened once, in August.
 - **RT-5** — Authorized-but-wrong requests: no mechanism anywhere checks the *content* of a change. Gates
   authenticate the asker and nothing else. Demonstrated on ourselves tonight.
+
+### 2026-09-18 — RT-3 scratch-envelope test and RT-7 identity isolation
+
+Tarik ran the required offline scratch test with fake credentials
+(`tests/test_mail_identity_credentials.py`). An inbound-derived reply body containing forged `To`,
+`From`, and `Subject` lines remains MIME body text and does not replace the SMTP envelope constructed
+from the repository draft headers.
+
+The test exposed a separate live attribution defect: `channels/mail.py::credentials_for()` allowed an
+explicit `Identity: tarik` draft to fall back to the generic mailbox when Tarik's credentials were
+absent. That could send Tarik-attributed mail authenticated as another amigo. Explicit identities now
+fail closed and use only their own credential pair; generic credentials remain available only to drafts
+without an identity. Owner: Tarik. Done-state: strict identity test and fake-SMTP envelope test passing.
+
+**Next action, 2026-09-19:** test the remaining RT-3 boundary — whether adversarial inbound text can
+control the model-generated reply body that `run_auto_reply()` immediately sends — then add a mechanical
+body-integrity or review gate rather than relying on the prompt's instruction to ignore inbound commands.
 
 ### Rules for any test, because a red team that damages the thing it is testing has failed worse than the vulnerability would have
 1. Never against the live repository. Scratch clone, or a temporary directory, always.
