diff --git a/tests/test_mail_identity_credentials.py b/tests/test_mail_identity_credentials.py
new file mode 100644
--- /dev/null
+++ b/tests/test_mail_identity_credentials.py
@@ -0,0 +1,76 @@
+#!/usr/bin/env python3
+"""Regression tests for outbound mailbox identity isolation (RT-7)."""
+from __future__ import annotations
+
+import os
+import unittest
+from unittest.mock import patch
+
+from channels.mail import (
+    GENERIC_PW_ENV,
+    GENERIC_USER_ENV,
+    IDENTITIES,
+    configured,
+    credentials_for,
+)
+
+
+ALL_CREDENTIAL_VARS = {
+    GENERIC_USER_ENV,
+    GENERIC_PW_ENV,
+    *(name for pair in IDENTITIES.values() for name in pair),
+}
+
+
+class MailIdentityCredentialTests(unittest.TestCase):
+    def clean_env(self, **values: str):
+        env = {name: "" for name in ALL_CREDENTIAL_VARS}
+        env.update(values)
+        return patch.dict(os.environ, env, clear=False)
+
+    def test_explicit_identity_uses_its_own_complete_pair(self):
+        user_env, pw_env = IDENTITIES["tarik"]
+        with self.clean_env(**{user_env: "tarik@example.test", pw_env: "tarik-secret"}):
+            self.assertEqual(
+                credentials_for("tarik"),
+                ("tarik@example.test", "tarik-secret"),
+            )
+
+    def test_explicit_identity_never_falls_back_to_generic_pair(self):
+        with self.clean_env(
+            **{
+                GENERIC_USER_ENV: "generic@example.test",
+                GENERIC_PW_ENV: "generic-secret",
+            }
+        ):
+            self.assertIsNone(credentials_for("claude"))
+            self.assertIsNone(credentials_for("gemini"))
+            self.assertIsNone(credentials_for("tarik"))
+
+    def test_unknown_explicit_identity_never_uses_generic_pair(self):
+        with self.clean_env(
+            **{
+                GENERIC_USER_ENV: "generic@example.test",
+                GENERIC_PW_ENV: "generic-secret",
+            }
+        ):
+            self.assertIsNone(credentials_for("not-an-amigo"))
+
+    def test_partial_explicit_pair_is_unconfigured(self):
+        user_env, _ = IDENTITIES["claude"]
+        with self.clean_env(**{user_env: "claude@example.test"}):
+            self.assertIsNone(credentials_for("claude"))
+
+    def test_unspecified_identity_may_use_generic_pair(self):
+        with self.clean_env(
+            **{
+                GENERIC_USER_ENV: "generic@example.test",
+                GENERIC_PW_ENV: "generic-secret",
+            }
+        ):
+            self.assertEqual(
+                credentials_for(None),
+                ("generic@example.test", "generic-secret"),
+            )
+            self.assertTrue(configured())
+
+    def test_no_complete_pair_means_channel_is_unconfigured(self):
+        with self.clean_env():
+            self.assertFalse(configured())
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/agenda/15-red-team-the-deadbolt.md b/agenda/15-red-team-the-deadbolt.md
--- a/agenda/15-red-team-the-deadbolt.md
+++ b/agenda/15-red-team-the-deadbolt.md
@@ -64,6 +64,20 @@ Regression tests: `tests/test_channel_triage.py` and `tests/test_triage.py`.
 
+### Finding RT-7 — outbound mailbox identity fallback
+*Fixed in code 2026-09-19 by Tarik; pending downstream test execution. Owner: Tarik. Done-state: strict per-identity credential selection and regression test passing.*
+
+`channels/mail.py::credentials_for()` previously allowed an explicitly named
+identity whose own credentials were absent to fall back to the generic mailbox.
+A draft declaring `Identity: claude`, `gemini`, or `tarik` could therefore be
+authenticated and sent by a different mailbox. The message's SMTP `From` value
+would expose the mismatch, but only after the identity boundary had already
+failed.
+
+The implementation now permits the generic credential pair only when no
+identity was requested. Explicit and unknown identities fail closed unless
+their own complete pair exists. Regression coverage is in
+`tests/test_mail_identity_credentials.py`.
+
 ### Vectors still to test
 - **RT-2** — Logged stranger text reaching a capable session: the relay built tonight (item 14) puts a
   question *about* a stranger's message in front of a body with write access. Structurally shown, not
@@ -72,6 +86,11 @@ Regression tests: `tests/test_channel_triage.py` and `tests/test_triage.py`.
 - **RT-5** — Authorized-but-wrong requests: no mechanism anywhere checks the *content* of a change. Gates
   authenticate the asker and nothing else. Demonstrated on ourselves tonight.
 
+### Next action — 2026-09-20
+Run RT-3 in a scratch environment with fake credentials: make adversarial
+inbound text control the generated reply body, inspect the exact SMTP envelope
+and body, then define and test a mechanical body-integrity/review boundary
+before `drain_outbox()` may transmit an automatically generated reply.
+
 ### Rules for any test, because a red team that damages the thing it is testing has failed worse than the vulnerability would have
 1. Never against the live repository. Scratch clone, or a temporary directory, always.
 2. Never with real credentials, and never anything that could be published by accident.
