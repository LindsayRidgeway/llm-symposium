+RACQUET_REACH = 3.0   # racquet plus arm, in feet: how far a player can reach without another step
+
+
+def plan_after_bounce(land, bounce: dict, surface: str, horizon: float = 3.0,
+                      step: float = 0.02) -> list[tuple[float, float, float]]:
+    """The ball's ground-plane path after it bounces, sampled every `step` seconds.
+
+    Stops at the second bounce, because a ball that has bounced twice is not hittable, and wherever it leaves
+    the court, because running past the fence is not a shot. The 0.02s step is the cadence the backlog's item 10
+    asks for; drag is integrated with the same `DRAG` the flight uses, so the plan and the shot cannot disagree
+    about how the air behaves. Euler at 0.02s, not the 0.001s the flight uses: this is a reachability plan, not
+    a landing point, and the difference is under a hundredth of a foot over the four or five steps that matter.
+    """
+    x, y = land
+    vx, vy, vz = bounce["v"]
+    pts = [(0.0, x, y)]
+    z, t = 0.0, 0.0
+    while t < horizon:
+        rel = math.sqrt(vx * vx + vy * vy + vz * vz)
+        ax = -DRAG * rel * vx
+        ay = -DRAG * rel * vy
+        az = -DRAG * rel * vz - G
+        nx, ny, nz = x + vx * step, y + vy * step, z + vz * step
+        if nz <= 0:                                     # the second bounce ends the hittable window
+            break
+        vx, vy, vz = vx + ax * step, vy + ay * step, vz + az * step
+        x, y, z = nx, ny, nz
+        t += step
+        pts.append((t, x, y))
+        if not (0.0 <= x <= LENGTH) or not (0.0 <= y <= WIDTH):
+            break                                       # it has left the court
+    return pts
+
